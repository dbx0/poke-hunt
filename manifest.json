{
  "manifest_version": 3,
  "name": "Poke Hunt",
  "version": "0.7.1",
  "description": "Calculate the best hunting routes on Poke Idle World",
  "browser_specific_settings": {
    "gecko": {
      "id": "poke-hunt@maldbx0",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "icons": {
    "16": "assets/gengar16.png",
    "48": "assets/gengar48.png",
    "128": "assets/gengar.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://poke.idleworld.online/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://poke.idleworld.online/*"
      ],
      "js": [
        "engine.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/creatures.json",
        "data/hunts.json",
        "data/speeds.json",
        "data/typechart.json",
        "data/clans.json",
        "data/items.json",
        "data/meta.json",
        "ui/modal.css",
        "assets/gengar.png",
        "assets/gengar-logo.png",
        "assets/pokehunt-logo.png",
        "assets/sprites/*.png"
      ],
      "matches": [
        "https://poke.idleworld.online/*"
      ]
    }
  ]
}
